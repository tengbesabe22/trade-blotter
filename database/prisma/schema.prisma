generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Instrument {
  id        String         @id @default(uuid()) @db.Uuid
  symbol    String         @unique @db.VarChar(12)
  name      String         @db.VarChar(120)
  currency  String         @default("USD") @db.VarChar(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  trades    Trade[]
  summary   SymbolSummary?
}

/// Current desk totals across all traders/books. SQL checks enforce nonnegative totals/version.
model SymbolSummary {
  id           String     @id @default(uuid()) @db.Uuid
  instrumentId String     @unique @db.Uuid
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  buyQuantity  Decimal    @default(0) @db.Decimal(28, 6)
  sellQuantity Decimal    @default(0) @db.Decimal(28, 6)
  buyValue     Decimal    @default(0) @db.Decimal(38, 10)
  sellValue    Decimal    @default(0) @db.Decimal(38, 10)
  version      Int        @default(0)
  /// Raw SQL updates must also explicitly set updatedAt.
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  displayName         String               @db.VarChar(120)
  email               String               @unique @db.VarChar(120)
  passwordHash        String               @db.VarChar(255)
  role                Role                 @default(TRADER)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  trades              Trade[]
  sessions            Session[]
  outboxEvents        OutboxEvent[]
  idempotencyRequests IdempotencyRequest[]
  auditEntries        TradeAudit[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)

  @@index([userId])
}

model Trade {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  instrumentId String        @db.Uuid
  instrument   Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  quantity     Decimal       @db.Decimal(20, 6)
  price        Decimal       @db.Decimal(18, 4)
  side         TradeSide
  book         String?       @db.VarChar(64)
  counterparty String?       @db.VarChar(120)
  tradeDate    DateTime      @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  /// Raw SQL updates must also explicitly set updatedAt.
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  status       TradeStatus   @default(ACTIVE)
  version      Int           @default(1)
  outboxEvents OutboxEvent[]
  auditEntries TradeAudit[]

  @@index([userId])
  @@index([instrumentId])
  // Supports execution-time ordering and its cursor tie-breaker; scans backward for newest first.
  @@index([tradeDate, id])
}

/// Append-only enforcement and snapshot checks live in the SQL migration.
model TradeAudit {
  id           String           @id @default(uuid()) @db.Uuid
  tradeId      String           @db.Uuid
  trade        Trade            @relation(fields: [tradeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tradeVersion Int
  action       TradeAuditAction
  actorId      String           @db.Uuid
  actor        User             @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reason       String?          @db.VarChar(500)
  /// Public trade DTO; decimal strings and UTC timestamps retain their exact format.
  snapshot     Json             @db.JsonB
  recordedAt   DateTime         @default(now()) @db.Timestamptz(3)

  // The unique index also supports a trade's history ordered by version.
  @@unique([tradeId, tradeVersion])
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  type          TradeEventType
  actorId       String            @db.Uuid
  actor         User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  tradeId       String            @db.Uuid
  trade         Trade             @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  tradeVersion  Int
  payload       Json              @db.JsonB
  status        OutboxEventStatus @default(PENDING)
  publishedAt   DateTime?         @db.Timestamptz(3)
  retries       Int               @default(0)
  /// Immediately eligible on creation; moved forward only for retry backoff.
  nextAttemptAt DateTime          @default(now()) @db.Timestamptz(3)
  lastError     String?           @db.Text
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([tradeId, tradeVersion])
  @@index([status, nextAttemptAt, createdAt])
}

model IdempotencyRequest {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  key                String   @db.VarChar(120)
  requestFingerprint String   @db.VarChar(64)
  responseBody       Json     @db.JsonB
  responseStatus     Int
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, key])
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  ACTIVE
  CANCELLED
}

enum Role {
  TRADER
  READ_ONLY
}

enum TradeEventType {
  TRADE_CREATED
  TRADE_AMENDED
  TRADE_CANCELLED
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
}

enum TradeAuditAction {
  CREATED
  AMENDED
  CANCELLED
}
