{
  "name": "trade-blotter",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter @trade-blotter/backend dev",
    "build": "pnpm --filter @trade-blotter/backend build",
    "start": "pnpm --filter @trade-blotter/backend start",
    "typecheck": "pnpm --filter @trade-blotter/backend typecheck",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:validate": "pnpm --filter @trade-blotter/database validate",
    "db:migrate:create": "pnpm --filter @trade-blotter/database migrate:create",
    "db:migrate:dev": "pnpm --filter @trade-blotter/database migrate:dev",
    "db:studio": "pnpm --filter @trade-blotter/database studio",
    "db:seed": "pnpm --filter @trade-blotter/database seed"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  }
}
