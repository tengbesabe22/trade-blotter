{
  "name": "@trade-blotter/backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "test:trades": "tsx --test test/trades.test.ts",
    "test:trade-create": "tsx --test test/trade-create.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@trade-blotter/database": "workspace:*",
    "dotenv": "18.0.10",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
